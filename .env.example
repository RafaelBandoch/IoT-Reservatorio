# ============================================================
# Variáveis do stack — copie de .env.example e preencha.
# Este arquivo tem SENHA REAL e está no .gitignore.
#
# O Mosquitto do compose é o broker do projeto, com TLS na 8883 e
# usuário por dispositivo; não há bridge (MQTT_BRIDGE=false).
#
# Para espelhar com o broker público em vez disso:
#   cp .env.publico .env && docker compose up -d --force-recreate
# ============================================================

# ---- PostgreSQL --------------------------------------------
POSTGRES_DB=reservatorio
POSTGRES_USER=iot
POSTGRES_PASSWORD=troque-aqui
POSTGRES_PORT=5432

# ---- MQTT: prefixo dos tópicos do projeto -------------------
MQTT_PREFIXO=catolicasc-g4/reservatorio

# ---- MQTT: bridge para um broker remoto ---------------------
# false = sem bridge: o ESP32 publica direto no Mosquitto local e
#         as variáveis MQTT_REMOTE_* abaixo são ignoradas.
# true  = o Mosquitto local espelha os tópicos com o broker remoto.
MQTT_BRIDGE=false

MQTT_REMOTE_HOST=seu-cluster.s1.eu.hivemq.cloud
MQTT_REMOTE_PORT=8883

# TLS: obrigatório no HiveMQ Cloud (não existe porta sem
# criptografia). Deixe "false" para o broker público.
MQTT_REMOTE_TLS=true

# Credenciais do cluster. Vazias = conexão anônima (broker público).
MQTT_REMOTE_USER=esp32
MQTT_REMOTE_PASS=troque-aqui

# ID único desta bridge no broker remoto
MQTT_BRIDGE_CLIENT_ID=catolicasc-g4-bridge-a7f3
# Rede sem IPv4 nativo (só IPv6 + NAT64): preencha com o MESMO valor de
# MQTT_REMOTE_HOST e rode o relay-mqtt.py no Mac. Vazio = ligação direta.
MQTT_BRIDGE_VIA_HOST=


# ---- Broker do projeto (Mosquitto com TLS) -------------------
# Porta MQTT com TLS exposta no computador (os ESP32 conectam nela).
# Antes da primeira subida: ./mosquitto/gerar-certificados.sh
MQTT_TLS_PORT=8883
# Senha de cada usuário do broker. As dos ESP32 vão também no
# credenciais.h (MQTT_SENHA_MEDIDOR e MQTT_SENHA_CONTROLADOR).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(18))"
MQTT_SENHA_BACKEND=troque-aqui
MQTT_SENHA_MEDIDOR=troque-aqui
MQTT_SENHA_CONTROLADOR=troque-aqui

# ---- Backend (FastAPI) --------------------------------------
BACKEND_PORT=8000

# Segredo dos tokens de login (JWT), com 32 caracteres ou mais.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# Usuário admin do painel (comandos e parâmetros), criado na subida.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-aqui
# Usuário só de leitura (opcional)
VISUALIZADOR_USUARIO=
VISUALIZADOR_SENHA=

# ---- Telegram (fase 4) --------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Regra de amostragem da tabela "leituras" (coletor da N1) --
AMOSTRAGEM_INTERVALO_S=30
AMOSTRAGEM_DELTA_NIVEL=5

# ---- pgAdmin (interface web do banco) -----------------------
PGADMIN_EMAIL=admin@reservatorio.com
PGADMIN_PASSWORD=troque-aqui
PGADMIN_PORT=5050

# ---- Fuso horário dos containers ----------------------------
# Sem isso os logs e o banco saem em UTC (3 h à frente).
TZ=America/Sao_Paulo
